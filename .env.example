# ─── Required ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/mediconnect?retryWrites=true&w=majority
JWT_SECRET=change-me-minimum-32-chars-random-string
JWT_EXPIRES_IN=7d
NODE_ENV=production

# ─── HIPAA/GDPR Encryption ───────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=<64-char-hex-string>
BLIND_INDEX_KEY=<64-char-hex-string-different-from-above>

# ─── Redis (BullMQ workers) ───────────────────────────────────────────────────
# Railway: add Redis plugin → copy REDIS_URL it provides
REDIS_URL=redis://:password@host:6379

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://mediconnect-web.up.railway.app

# ─── Admin ───────────────────────────────────────────────────────────────────
ADMIN_SECRET=change-me-strong-admin-secret

# ─── AI — Claude ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# ─── Firebase FCM push notifications ─────────────────────────────────────────
FCM_SERVER_KEY=AAAA...
# JSON-stringified Firebase service account key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ─── File uploads (Cloudinary) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret

# ─── Video consultations (Daily.co) ──────────────────────────────────────────
DAILY_API_KEY=your-daily-api-key
DAILY_DOMAIN=your-subdomain.daily.co

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
